{
  "data_yaml": "fomoPy/data/yolo_dataset/data.yaml",
  "labels_dir": "fomoPy/data/yolo_labels",
  "image_size": 96,
  "grid_size": 12,
  "epochs": 80,
  "batch_size": 16,
  "lr": 0.001,
  "aug_multiplier": 1,
  "hflip_prob": 0.5,
  "seed": 42,
  "bg_weight": 0.25,
  "fg_weight": 2.0,
  "focal_gamma": 2.0,
  "metric_threshold": 0.35,
  "label_mode": "soft-box",
  "bbox_radius_scale": 0.25,
  "min_target_radius": 0,
  "max_target_radius": 3,
  "optimizer": "adamw",
  "weight_decay": 0.0001,
  "stage_width_scale": 1.0,
  "head_filters": 32,
  "refine_blocks": 1,
  "dropout_rate": 0.05,
  "dice_weight": 0.15,
  "auto_class_weight": false,
  "min_class_weight": 0.75,
  "max_class_weight": 4.0,
  "focus_classes": "",
  "focus_multiplier": 1,
  "save_h5": false,
  "skip_tflite": false,
  "out_dir": "fomoPy/outputs/fomo_local",
  "no_early_stop": true,
  "stage_filters": [
    8,
    16,
    24
  ],
  "classes": [
    "Tennis",
    "Tennis player",
    "Tennis racket"
  ]
}